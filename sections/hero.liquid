<section class="hero" style="padding: {{ section.settings.padding }}px">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when "heading" %}<h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
      {% when "cta" %}<a class="btn" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {% endcase %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "Hero",
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "New season" }] },
    { "type": "cta", "name": "Button", "settings": [{ "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "link", "label": "Link" }] }
  ],
  "settings": [{ "type": "range", "id": "padding", "min": 0, "max": 80, "step": 8, "default": 32, "label": "Padding" }]
}
{% endschema %}
{% comment %}rationale: settings schema drives the copy, no hardcoded text{% endcomment %}

